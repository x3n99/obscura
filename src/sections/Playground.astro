<section class="playground" id="playground">
  <div class="playground-header">
    <div class="section-meta">
      <span>04 / INTERACTIVE PLAYGROUND</span>
      <span>LIVE GENERATIVE SYSTEM</span>
    </div>

    <div class="playground-intro">
      <div>
        <p class="playground-label">AN INTERACTIVE EXPERIMENT</p>
        <h2>
          PLAY WITH<br />
          <span>THE UNKNOWN.</span>
        </h2>
      </div>

      <p class="playground-description">
        Move your cursor. Disturb the field. Discover what happens when
        interaction becomes the artwork.
      </p>
    </div>
  </div>

  <div class="playground-stage" data-playground>
    <canvas class="playground-canvas" data-playground-canvas aria-hidden="true"
    ></canvas>

    <div class="playground-stage-top">
      <span>FIELD GENERATOR / 001</span>
      <span class="field-status">
        <span class="status-indicator"></span>
        <span data-field-status>ACTIVE</span>
      </span>
    </div>

    <div class="playground-center" aria-hidden="true">
      <span>INTERACTION</span>
      <span>IS EVERYTHING<span class="title-dot">.</span></span>
    </div>

    <div class="playground-stage-bottom">
      <span data-field-hint>MOVE YOUR CURSOR TO EXPLORE</span>

      <button
        class="field-mode-button"
        type="button"
        data-field-toggle
        aria-label="Switch interaction mode"
      >
        MODE: <span data-field-mode>ATTRACT</span>
        <span aria-hidden="true">↗</span>
      </button>
    </div>
  </div>

  <div class="playground-footer">
    <span>BUILT FOR CURIOSITY.</span>
    <span>NO RULES. JUST INTERACTION.</span>
  </div>
</section>
